# ==========================================
# DevPulse Configuration
# ==========================================

PROJECT_NAME="DevPulse"
ENV="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# GitHub API Credentials (Optional - unauthenticated rate limit is 60 req/hr; token provides 5,000 req/hr)
# Generate a GitHub Personal Access Token (classic: read:user, repo:status or public_repo)
GITHUB_TOKEN=""
# Optional: require X-Admin-Token to change a profile's featured repositories
ADMIN_TOKEN=""

# Cache TTL (seconds)
CACHE_TTL_SECONDS=900  # 15 minutes default

# Database
DATABASE_URL="sqlite+aiosqlite:///./devpulse.db"
