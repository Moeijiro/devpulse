# Copy to .env (next to this file or in backend/). Every value has a development default.
ENV=development
# Origins allowed to call the API from a browser (the Next.js app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite+aiosqlite:///./devpulse.db

# Optional GitHub token: raises the API limit from 60 to 5,000 requests an hour (no scopes needed).
GITHUB_TOKEN=
# How long GitHub data is cached, in seconds.
CACHE_TTL_SECONDS=900
# Optional: require X-Admin-Token to change a profile's featured repositories.
ADMIN_TOKEN=
